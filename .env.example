# ============================================================
# CAIP 环境变量模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# 数据库配置
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis配置
REDIS_HOST=localhost

# JWT密钥 (至少256位，生产环境须更换)
JWT_SECRET=please-change-this-secret-key-in-production-min-256-bits

# 文件上传路径
FILE_UPLOAD_PATH=./uploads/images/
